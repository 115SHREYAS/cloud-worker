{
      "$schema": "https://turbo.build/schema.json",
      "tasks": {
        "build": {
          "dependsOn": ["^build"],
          "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_API_URL"],
          "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
          "cache": false,
          "persistent": true
        },
        "lint": {
          "dependsOn": ["^lint"]
        },
        "typecheck": {
          "dependsOn": ["^typecheck"]
        }
      }
}