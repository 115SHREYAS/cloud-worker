{
      "name": "cloud-worker-root",
      "private": true,
      "packageManager": "pnpm@11.22.0",
      "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:server": "pnpm --filter @cloud-worker/server dev",
        "dev:web": "pnpm --filter web dev",
        "db:push": "pnpm --filter @cloud-worker/server db:push",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck"
      },
      "devDependencies": {
        "turbo": "^2.4.4",
        "typescript": "^5.8.2"
      }
    }