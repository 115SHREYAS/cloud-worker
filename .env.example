# Cloud Worker Environment Configuration Example

# Server & Runtime
NODE_ENV=development
PORT=3001

# Sandbox Provider (E2B Firecracker microVMs)
E2B_API_KEY=e2b_your_api_key_here

# Database & Event Bus (Optional - in-memory fallback enabled if omitted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloud_worker
REDIS_URL=redis://localhost:6379

# GitHub App Integration (Optional - PAT fallback enabled if omitted)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Fallback GitHub Token (Optional for testing)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# User Authentication (GitHub OAuth) & Session Security
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
ENCRYPTION_KEY=change-this-to-a-secure-encryption-key-for-credentials

# In-VM Agent Subscription Credentials (Optional - can also be configured via Web UI)
# CODEX_AUTH_JSON='{"token":"..."}'
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CLAUDE_AUTH_JSON='{"sessionKey":"..."}'
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Security & Execution Limits
MAX_TASK_DURATION_MS=900000
MAX_TOOL_ITERATIONS=50
